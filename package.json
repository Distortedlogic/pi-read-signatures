{
	"name": "pi-read-signatures",
	"version": "0.1.0",
	"private": true,
	"description": "Read source declarations with callable bodies folded in Pi.",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Distortedlogic/pi-read-signatures.git"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"exports": {
		".": "./src/index.ts",
		"./fold": "./src/fold.ts",
		"./languages": "./src/languages.ts"
	},
	"scripts": {
		"check": "npm run typecheck && npm run lint && npm test",
		"format": "biome check --write .",
		"lint": "biome check .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:e2e": "node --import tsx --test test/e2e.test.ts",
		"test:unit": "node --import tsx --test test/unit.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"files": [
		"AGENTS.yml",
		"grit",
		"src"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"dependencies": {
		"@getgrit/gritql": "0.0.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "0.87.0",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@earendil-works/pi-coding-agent": "0.87.0",
		"@types/node": "22.20.3",
		"tsx": "4.23.15",
		"typebox": "1.3.34",
		"typescript": "7.0.2"
	}
}
